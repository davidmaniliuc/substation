# Zig build artifacts
/zig-cache/
/.zig-cache/
/zig-out/

# OS / editor
.DS_Store
*.swp
*~

*.bin
*.BIN
# ...except the reverb/SPU golden fixtures, which are checked-in test data,
# not BIOS/disc images — without this, `git add` on a new golden silently
# no-ops.
!ps1-core/tests/goldens/*.bin
!ps1-core/tests/goldens/fixtures/*.p1fx

/.antigravitycli/
debug_output.txt
avocado_ref/
games/

# Xcode build products. SYMROOT for the macOS app, plus the per-user scheme and
# window state Xcode drops inside the .xcodeproj — the project file itself and
# its xcshareddata/ scheme ARE checked in, since `xcodebuild -scheme PS1`
# depends on the shared scheme existing.
/.build/
xcuserdata/
