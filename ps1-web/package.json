{
  "name": "ps1-web",
  "version": "0.1.0",
  "private": true,
  "description": "A PlayStation emulator for the browser: a typed core and a canvas player",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ps1.wasm": "./dist/ps1.wasm"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
